#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "pathname"

ROOT = File.expand_path("..", __dir__)
$LOAD_PATH.unshift(File.join(ROOT, "lib"))

begin
  require "bundler/setup"
rescue LoadError
  warn "bundler/setup missing — run: bundle install"
  exit 1
end

require "json_schemer"
require "pebr"

module Pebr
  module CLI
    module_function

    def usage
      <<~USAGE
        pebr #{Pebr::VERSION} — PEBR pipeline CLI

        Usage:
          bin/pebr validate              Validate fixtures + national + regional polls|witnesses vs schemas/
          bin/pebr assemble              Rebuild canonical-points.json (1º) + 2nd-round + canonical-points-regional.json
          bin/pebr discover              Read-only inventory of source-map + institutes (no fetch)
          bin/pebr watch [--offline|--fetch] [--dry-run] [--out PATH]
                                         Human-gated discovery: listing/RSS/sitemap/drop inbox → review queue
                                         (NEVER invents poll shares; default --offline uses fixtures)
          bin/pebr drop FILE [--source-url URL] [--title TITLE] [--source-id ID]
                                         Copy human-saved HTML/PDF into discovery inbox + hash bytes
          bin/pebr normalize             Fingerprint + anti-replicate report (national + regional; no rewrite)
          bin/pebr version               Print version
          bin/pebr help                  This message
      USAGE
    end

    def main(argv)
      cmd = argv[0] || "help"
      case cmd
      when "validate" then validate!
      when "assemble" then assemble!
      when "discover" then discover!
      when "watch" then watch!(argv[1..])
      when "drop" then drop!(argv[1..])
      when "normalize" then normalize!
      when "version", "-v", "--version"
        puts Pebr::VERSION
      when "help", "-h", "--help"
        puts usage
      else
        warn "Unknown command: #{cmd}\n\n#{usage}"
        exit 1
      end
    end

    def discover!
      result = Pebr::Discover.run
      puts result[:lines].join("\n")
      exit 0
    end

    def watch!(argv)
      mode = :offline
      dry_run = false
      out_path = nil
      argv = Array(argv)
      while (arg = argv.shift)
        case arg
        when "--offline" then mode = :offline
        when "--fetch" then mode = :fetch
        when "--dry-run" then dry_run = true
        when "--out"
          out_path = argv.shift or raise "--out requires a path"
        when "--help", "-h"
          puts usage
          exit 0
        else
          warn "watch: unknown option #{arg.inspect}\n\n#{usage}"
          exit 1
        end
      end
      opts = { mode: mode, dry_run: dry_run }
      opts[:out_path] = out_path if out_path
      result = Pebr::Watch.run(opts)
      puts result[:lines].join("\n")
      # Soft-fail only if every target errored and produced zero items
      if result[:doc]["items"].empty? && !result[:errors].empty?
        warn "watch: completed with errors and empty queue"
        exit 1
      end
      exit 0
    rescue StandardError => e
      warn "watch: FAILED — #{e.message}"
      exit 1
    end

    def drop!(argv)
      path = argv.shift
      raise "drop requires an HTML/PDF FILE" if path.nil? || path.start_with?("--")

      source_url = nil
      title = nil
      source_id = nil
      while (arg = argv.shift)
        case arg
        when "--source-url" then source_url = argv.shift or raise "--source-url requires a URL"
        when "--title" then title = argv.shift or raise "--title requires text"
        when "--source-id" then source_id = argv.shift or raise "--source-id requires an ID"
        when "--help", "-h"
          puts usage
          exit 0
        else
          raise "drop: unknown option #{arg.inspect}"
        end
      end

      result = Pebr::Intake.drop(path, root: ROOT, source_url: source_url, title: title, source_id: source_id)
      puts "drop: copied #{result[:path]}"
      puts "drop: #{result[:content_hash]}"
      puts "drop: run bin/pebr watch --offline, then create a human witness after primary-source review"
      exit 0
    rescue StandardError => e
      warn "drop: FAILED — #{e.message}"
      exit 1
    end

    def normalize!
      $stdout.sync = true
      $stderr.sync = true
      result = Pebr::Normalize.run
      puts "pebr normalize: fingerprint / anti-replicate report (national + regional; no fetch, no rewrite)"
      puts "  polls: #{result[:poll_count]}  witnesses: #{result[:witness_count]}  fingerprints: #{result[:fingerprint_count]}"
      result[:warnings].each { |w| puts "  warn: #{w}" }
      if result[:errors].empty?
        puts "normalize: OK (no hard replicate / fingerprint collisions)"
        exit 0
      else
        warn "normalize: FAILED"
        result[:errors].each { |e| warn "  - #{e}" }
        exit 1
      end
    end

    def assemble!
      result = Pebr::Assemble.run
      puts "assemble: wrote #{result[:count_1st]} 1st-round point(s) → #{result[:out_path]}"
      puts "assemble: wrote #{result[:count_2nd]} 2nd-round point(s) → #{result[:out_path_2nd]}"
      puts "assemble: wrote #{result[:count_regional]} regional point(s) → #{result[:out_path_regional]}"
      exit 0
    rescue StandardError => e
      warn "assemble: FAILED — #{e.message}"
      exit 1
    end

    def validate!
      errors = []
      checked = 0

      checked += validate_fixtures!(errors)
      checked += validate_regional_fixtures!(errors)
      checked += validate_national_tree!(errors)
      checked += validate_regional_tree!(errors)

      if errors.empty?
        puts "validate: #{checked} file(s) passed"
        exit 0
      else
        warn "validate: FAILED"
        errors.each { |e| warn "  - #{e}" }
        exit 1
      end
    end

    def validate_fixtures!(errors)
      schema_dir = Pathname.new(Pebr::SCHEMA_DIR)
      fixture_dir = Pathname.new(Pebr::FIXTURE_DIR)
      checked = 0

      Pebr::FIXTURE_SCHEMA_MAP.each do |fixture_name, schema_name|
        fixture_path = fixture_dir.join(fixture_name)
        schema_path = schema_dir.join(schema_name)

        unless fixture_path.file?
          errors << "#{fixture_name}: missing fixture at #{fixture_path}"
          next
        end
        unless schema_path.file?
          errors << "#{fixture_name}: missing schema at #{schema_path}"
          next
        end

        failures = validate_file(fixture_path, schema_path)
        checked += 1
        if failures.empty?
          puts "OK  fixtures/national/#{fixture_name}  ←  #{schema_name}"
        else
          failures.each { |msg| errors << "fixtures/national/#{fixture_name}: #{msg}" }
        end
      end

      extras = Dir.glob(fixture_dir.join("EXAMPLE_*.json").to_s).map { |p| File.basename(p) } -
               Pebr::FIXTURE_SCHEMA_MAP.keys
      extras.each { |name| errors << "#{name}: no schema mapping in Pebr::FIXTURE_SCHEMA_MAP" }
      checked
    end

    def validate_national_tree!(errors)
      checked = 0
      poll_dir = Pathname.new(Pebr::NATIONAL_POLL_DIR)
      wit_dir = Pathname.new(Pebr::NATIONAL_WITNESS_DIR)
      schema_dir = Pathname.new(Pebr::SCHEMA_DIR)
      poll_schema = schema_dir.join("poll.schema.json")
      wit_schema = schema_dir.join("witness.schema.json")

      poll_files = Dir.glob(poll_dir.join("*.json").to_s).sort
      wit_files = Dir.glob(wit_dir.join("*.json").to_s).sort

      if poll_files.empty? && wit_files.empty?
        puts "OK  data/national/** (empty — no intake files yet)"
        return checked
      end

      poll_ids = {}
      wit_ids = {}

      poll_files.each do |path|
        pn = Pathname.new(path)
        rel = pn.relative_path_from(Pathname.new(ROOT)).to_s
        failures = validate_file(pn, poll_schema)
        checked += 1
        if failures.empty?
          data = JSON.parse(pn.read)
          poll_ids[data["poll_id"]] = data
          puts "OK  #{rel}  ←  poll.schema.json"
          if File.basename(path, ".json") != data["poll_id"]
            errors << "#{rel}: filename stem must match poll_id #{data['poll_id'].inspect}"
          end
        else
          failures.each { |msg| errors << "#{rel}: #{msg}" }
        end
      end

      wit_files.each do |path|
        pn = Pathname.new(path)
        rel = pn.relative_path_from(Pathname.new(ROOT)).to_s
        failures = validate_file(pn, wit_schema)
        checked += 1
        if failures.empty?
          data = JSON.parse(pn.read)
          wit_ids[data["witness_id"]] = data
          puts "OK  #{rel}  ←  witness.schema.json"
          if File.basename(path, ".json") != data["witness_id"]
            errors << "#{rel}: filename stem must match witness_id #{data['witness_id'].inspect}"
          end
        else
          failures.each { |msg| errors << "#{rel}: #{msg}" }
        end
      end

      # Cross-link checks (soft identity integrity for intake)
      poll_ids.each do |pid, poll|
        Array(poll["witness_ids"]).each do |wid|
          unless wit_ids.key?(wid)
            errors << "poll #{pid}: witness_ids references missing witness #{wid.inspect}"
          end
        end
      end
      wit_ids.each do |wid, wit|
        pid = wit["poll_id"]
        next if pid.nil? || pid == ""
        unless poll_ids.key?(pid)
          errors << "witness #{wid}: poll_id references missing poll #{pid.inspect}"
        end
      end

      checked
    end

    def validate_regional_fixtures!(errors)
      schema_dir = Pathname.new(Pebr::SCHEMA_DIR)
      fixture_dir = Pathname.new(Pebr::FIXTURE_REGIONAL_DIR)
      checked = 0

      Pebr::FIXTURE_REGIONAL_SCHEMA_MAP.each do |fixture_name, schema_name|
        fixture_path = fixture_dir.join(fixture_name)
        schema_path = schema_dir.join(schema_name)

        unless fixture_path.file?
          errors << "#{fixture_name}: missing fixture at #{fixture_path}"
          next
        end
        unless schema_path.file?
          errors << "#{fixture_name}: missing schema at #{schema_path}"
          next
        end

        failures = validate_file(fixture_path, schema_path)
        checked += 1
        if failures.empty?
          puts "OK  fixtures/regional/#{fixture_name}  ←  #{schema_name}"
        else
          failures.each { |msg| errors << "fixtures/regional/#{fixture_name}: #{msg}" }
        end
      end

      extras = Dir.glob(fixture_dir.join("EXAMPLE_*.json").to_s).map { |p| File.basename(p) } -
               Pebr::FIXTURE_REGIONAL_SCHEMA_MAP.keys
      extras.each { |name| errors << "fixtures/regional/#{name}: no schema mapping in Pebr::FIXTURE_REGIONAL_SCHEMA_MAP" }
      checked
    end

    def validate_regional_tree!(errors)
      checked = 0
      poll_dir = Pathname.new(Pebr::REGIONAL_POLL_DIR)
      wit_dir = Pathname.new(Pebr::REGIONAL_WITNESS_DIR)
      schema_dir = Pathname.new(Pebr::SCHEMA_DIR)
      poll_schema = schema_dir.join("poll-regional.schema.json")
      wit_schema = schema_dir.join("witness.schema.json")

      poll_files = Dir.glob(poll_dir.join("*.json").to_s).sort
      wit_files = Dir.glob(wit_dir.join("*.json").to_s).sort

      if poll_files.empty? && wit_files.empty?
        puts "OK  data/regional/** (empty stub — no regional intake yet)"
        return checked
      end

      poll_ids = {}
      wit_ids = {}

      poll_files.each do |path|
        pn = Pathname.new(path)
        rel = pn.relative_path_from(Pathname.new(ROOT)).to_s
        failures = validate_file(pn, poll_schema)
        checked += 1
        if failures.empty?
          data = JSON.parse(pn.read)
          poll_ids[data["poll_id"]] = data
          puts "OK  #{rel}  ←  poll-regional.schema.json"
          if File.basename(path, ".json") != data["poll_id"]
            errors << "#{rel}: filename stem must match poll_id #{data['poll_id'].inspect}"
          end
          if data["geography"] != "state"
            errors << "#{rel}: geography must be state (got #{data['geography'].inspect})"
          end
        else
          failures.each { |msg| errors << "#{rel}: #{msg}" }
        end
      end

      wit_files.each do |path|
        pn = Pathname.new(path)
        rel = pn.relative_path_from(Pathname.new(ROOT)).to_s
        failures = validate_file(pn, wit_schema)
        checked += 1
        if failures.empty?
          data = JSON.parse(pn.read)
          wit_ids[data["witness_id"]] = data
          puts "OK  #{rel}  ←  witness.schema.json"
          if File.basename(path, ".json") != data["witness_id"]
            errors << "#{rel}: filename stem must match witness_id #{data['witness_id'].inspect}"
          end
        else
          failures.each { |msg| errors << "#{rel}: #{msg}" }
        end
      end

      poll_ids.each do |pid, poll|
        Array(poll["witness_ids"]).each do |wid|
          unless wit_ids.key?(wid)
            errors << "regional poll #{pid}: witness_ids references missing witness #{wid.inspect}"
          end
        end
      end
      wit_ids.each do |wid, wit|
        pid = wit["poll_id"]
        next if pid.nil? || pid == ""
        unless poll_ids.key?(pid)
          errors << "regional witness #{wid}: poll_id references missing poll #{pid.inspect}"
        end
      end

      checked
    end

    def validate_file(data_path, schema_path)
      schema = JSON.parse(schema_path.read)
      data = JSON.parse(data_path.read)
      schemer = JSONSchemer.schema(schema)
      schemer.validate(data).map do |err|
        pointer = err["data_pointer"] || err["schema_pointer"] || "?"
        type = err["type"] || "error"
        detail = err["error"] || err["details"] || err.inspect
        "#{type} at #{pointer} — #{detail}"
      end
    end
  end
end

Pebr::CLI.main(ARGV)
